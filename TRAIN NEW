import pandas as pd
import numpy as np
from sklearn.preprocessing import StandardScaler
from sklearn.ensemble import GradientBoostingRegressor
from sklearn.metrics import r2_score, mean_absolute_error, mean_squared_error
from sklearn.model_selection import cross_val_score, KFold
import joblib
import os
import json
import warnings
warnings.filterwarnings('ignore')

class AntennaParameterPredictor:
    def __init__(self):
        self.models = {}
        self.scalers = {}
        self.performance_metrics = {}
        self.feature_names = ['freq1_GHz', 'freq2_GHz', 's11_at_freq1_dB', 
                              's11_at_freq2_dB', 'bw1_GHz', 'bw2_GHz']
        self.target_params = ['A', 'B', 'C', 'D', 'E', 'F']
    
    def create_model(self, param_name):
        if param_name == 'B':
            return GradientBoostingRegressor(
                n_estimators=120,
                max_depth=4,
                learning_rate=0.08,
                subsample=0.8,
                min_samples_split=5,
                min_samples_leaf=3,
                random_state=42
            )
        elif param_name in ['E', 'F']:
            return GradientBoostingRegressor(
                n_estimators=150,
                max_depth=5,
                learning_rate=0.06,
                subsample=0.85,
                min_samples_split=4,
                min_samples_leaf=2,
                random_state=42
            )
        else:
            return GradientBoostingRegressor(
                n_estimators=100,
                max_depth=4,
                learning_rate=0.08,
                subsample=0.8,
                min_samples_split=5,
                min_samples_leaf=3,
                random_state=42
            )
    
    def train_models(self, X_train, y_train, X_val=None, y_val=None):
        print("Training models for antenna parameters...")
        print("=" * 60)
        
        for param in self.target_params:
            print(f"\nTraining model for parameter {param}...")
            
            y_param_train = y_train[param].values
            
            scaler = StandardScaler()
            X_train_scaled = scaler.fit_transform(X_train)
            
            model = self.create_model(param)
            
            sample_weights = self._calculate_sample_weights(X_train, y_param_train, param)
            
            model.fit(X_train_scaled, y_param_train, sample_weight=sample_weights)
            
            self.models[param] = model
            self.scalers[param] = scaler
            
            y_pred_train = model.predict(X_train_scaled)
            if param == 'B':
                y_pred_train = np.round(y_pred_train).astype(int)
            
            train_r2 = r2_score(y_param_train, y_pred_train)
            train_mae = mean_absolute_error(y_param_train, y_pred_train)
            
            if X_val is not None and y_val is not None:
                X_val_scaled = scaler.transform(X_val)
                y_param_val = y_val[param].values
                y_pred_val = model.predict(X_val_scaled)
                
                if param == 'B':
                    y_pred_val = np.round(y_pred_val).astype(int)
                
                val_r2 = r2_score(y_param_val, y_pred_val)
                val_mae = mean_absolute_error(y_param_val, y_pred_val)
                
                print(f"  Training   - R²: {train_r2:.4f}, MAE: {train_mae:.4f}")
                print(f"  Validation - R²: {val_r2:.4f}, MAE: {val_mae:.4f}")
                
                self.performance_metrics[param] = {
                    'train_r2': train_r2,
                    'train_mae': train_mae,
                    'val_r2': val_r2,
                    'val_mae': val_mae
                }
            else:
                print(f"  Training - R²: {train_r2:.4f}, MAE: {train_mae:.4f}")
                self.performance_metrics[param] = {
                    'train_r2': train_r2,
                    'train_mae': train_mae
                }
    
    def _calculate_sample_weights(self, X, y, param):
        weights = np.ones(len(y))
        
        dual_band_mask = (X['s11_at_freq1_dB'].values < -10) & \
                        (X['s11_at_freq2_dB'].values < -10)
        weights[dual_band_mask] = 1.5
        
        if param == 'B':
            b_mask = (y == 6) | (y == 5)
            weights[b_mask] *= 1.2
        elif param == 'A':
            a_distance = np.abs(y - 9.8)
            weights *= np.exp(-a_distance / 2)
        elif param == 'E' or param == 'F':
            distance = np.abs(y - 1.0)
            weights *= np.exp(-distance / 1)
            
        return weights
    
    def cross_validate(self, X, y, cv_folds=5):
        print("\nPerforming cross-validation...")
        print("=" * 60)
        
        kfold = KFold(n_splits=cv_folds, shuffle=True, random_state=42)
        cv_results = {}
        
        for param in self.target_params:
            y_param = y[param].values
            model = self.create_model(param)
            scaler = StandardScaler()
            
            X_scaled = scaler.fit_transform(X)
            
            cv_scores = cross_val_score(model, X_scaled, y_param, 
                                       cv=kfold, scoring='r2')
            
            cv_results[param] = {
                'mean_r2': cv_scores.mean(),
                'std_r2': cv_scores.std(),
                'scores': cv_scores.tolist()
            }
            
            print(f"Parameter {param}: CV R² = {cv_scores.mean():.4f} "
                  f"(+/- {cv_scores.std() * 2:.4f})")
        
        return cv_results
    
    def save_models(self, model_dir='models'):
        os.makedirs(model_dir, exist_ok=True)
        
        for param in self.target_params:
            model_path = os.path.join(model_dir, f'model_{param}.pkl')
            joblib.dump(self.models[param], model_path)
            
            scaler_path = os.path.join(model_dir, f'scaler_{param}.pkl')
            joblib.dump(self.scalers[param], scaler_path)
        
        metrics_path = os.path.join(model_dir, 'performance_metrics.json')
        with open(metrics_path, 'w') as f:
            json.dump(self.performance_metrics, f, indent=2)
        
        print(f"\nModels saved to '{model_dir}/' directory")

def evaluate_dual_band_performance(predictor, X_test, y_test):
    print("\nEvaluating Dual-Band Classification Performance...")
    print("=" * 60)
    
    dual_band_mask = (X_test['s11_at_freq1_dB'].values < -10) & \
                    (X_test['s11_at_freq2_dB'].values < -10)
    
    X_test_scaled = predictor.scalers['B'].transform(X_test)
    b_predictions = predictor.models['B'].predict(X_test_scaled)
    b_predictions = np.round(b_predictions).astype(int)
    
    predicted_dual = (b_predictions == 6) | (b_predictions == 5)
    
    true_positives = np.sum(dual_band_mask & predicted_dual)
    true_negatives = np.sum(~dual_band_mask & ~predicted_dual)
    false_positives = np.sum(~dual_band_mask & predicted_dual)
    false_negatives = np.sum(dual_band_mask & ~predicted_dual)
    
    accuracy = (true_positives + true_negatives) / len(X_test)
    precision = true_positives / (true_positives + false_positives) if (true_positives + false_positives) > 0 else 0
    recall = true_positives / (true_positives + false_negatives) if (true_positives + false_negatives) > 0 else 0
    f1 = 2 * (precision * recall) / (precision + recall) if (precision + recall) > 0 else 0
    
    print(f"Accuracy:  {accuracy:.4f}")
    print(f"Precision: {precision:.4f}")
    print(f"Recall:    {recall:.4f}")
    print(f"F1-Score:  {f1:.4f}")
    
    print(f"\nConfusion Matrix:")
    print(f"                Predicted")
    print(f"              Single  Dual")
    print(f"Actual Single  {true_negatives:4d}  {false_positives:4d}")
    print(f"       Dual    {false_negatives:4d}  {true_positives:4d}")
    
    return {
        'accuracy': accuracy,
        'precision': precision,
        'recall': recall,
        'f1_score': f1
    }

def main():
    print("\n" + "=" * 60)
    print("ANTENNA PARAMETER ML MODEL TRAINING")
    print("=" * 60)
    
    print("\nLoading training data...")
    X_train = pd.read_csv('data/X_train.csv')
    X_val = pd.read_csv('data/X_val.csv')
    X_test = pd.read_csv('data/X_test.csv')
    y_train = pd.read_csv('data/y_train.csv')
    y_val = pd.read_csv('data/y_val.csv')
    y_test = pd.read_csv('data/y_test.csv')
    
    print(f"Training samples: {len(X_train)}")
    print(f"Validation samples: {len(X_val)}")
    print(f"Test samples: {len(X_test)}")
    
    predictor = AntennaParameterPredictor()
    predictor.train_models(X_train, y_train, X_val, y_val)
    
    cv_results = predictor.cross_validate(X_train, y_train)
    
    print("\nFinal Test Set Evaluation:")
    print("=" * 60)
    
    for param in predictor.target_params:
        X_test_scaled = predictor.scalers[param].transform(X_test)
        y_test_param = y_test[param].values
        y_pred = predictor.models[param].predict(X_test_scaled)
        
        if param == 'B':
            y_pred = np.round(y_pred).astype(int)
        
        test_r2 = r2_score(y_test_param, y_pred)
        test_mae = mean_absolute_error(y_test_param, y_pred)
        test_rmse = np.sqrt(mean_squared_error(y_test_param, y_pred))
        
        print(f"Parameter {param}:")
        print(f"  R² Score: {test_r2:.4f}")
        print(f"  MAE: {test_mae:.4f}")
        print(f"  RMSE: {test_rmse:.4f}")
        
        predictor.performance_metrics[param]['test_r2'] = test_r2
        predictor.performance_metrics[param]['test_mae'] = test_mae
        predictor.performance_metrics[param]['test_rmse'] = test_rmse
    
    dual_band_metrics = evaluate_dual_band_performance(predictor, X_test, y_test)
    
    predictor.save_models()
    
    print("\n" + "=" * 60)
    print("Training completed successfully!")
    print("=" * 60)
    
    return predictor

if __name__ == "__main__":
    predictor = main()
